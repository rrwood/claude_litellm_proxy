# NVIDIA NIM API Key
# Get yours at: https://build.nvidia.com/nim
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Google AI Studio API Key (optional - for Gemini models)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter API Key (fallback provider when NIM is unavailable)
# Get yours at: https://openrouter.ai/keys (free, no payment method needed)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Config repo (optional - pull litellm_config.yaml from git on startup)
# Allows config updates without rebuilding the image
# CONFIG_REPO_URL=https://github.com/youruser/claude-litellm-proxy.git
# CONFIG_REPO_BRANCH=main
# CONFIG_REPO_PATH=config/litellm_config.yaml

# LiteLLM Admin UI Credentials (optional but recommended)
# Access the UI at: http://YOUR_CONTAINER_IP:4000/ui
UI_USERNAME=admin
UI_PASSWORD=changeme123
